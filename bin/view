#!/bin/sh
# view FILE.pdf        open a PDF in the Herdr viewer, beside this terminal
# view --tab FILE.pdf  open it in a new tab
# Anything else (other files, options, no Herdr) goes to the system's `view` (vim -R).
set -eu

place="${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/pdf-viewer/place.py"

tab=
[ "${1:-}" = "--tab" ] && { tab=--tab; shift; }

is_pdf() {
  case "$1" in *.pdf|*.PDF|*.Pdf) return 0 ;; *) return 1 ;; esac
}

if [ $# -eq 1 ] && is_pdf "$1"; then
  [ -f "$1" ] || { echo "view: no such file: $1" >&2; exit 1; }
  if [ -n "${HC_TERMINAL_ID:-}" ] && [ -f "$place" ]; then
    exec python3 "$place" $tab "$1"
  fi
  exec open "$1"   # outside Herdr: the default app
fi

[ -n "$tab" ] && set -- --tab "$@"
exec /usr/bin/view "$@"
