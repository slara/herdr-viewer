#!/bin/sh
# view FILE         open a PDF, Markdown file or image in the Herdr viewer
# view --tab FILE   open it in a new tab
# Anything else (other files, options, no Herdr) goes to the system's `view` (vim -R).
set -eu

mods="${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/viewer"

tab=
[ "${1:-}" = "--tab" ] && { tab=--tab; shift; }

# router.py holds the list of types the viewer shows.
is_doc() {
  [ -f "$mods/router/router.py" ] && python3 "$mods/router/router.py" kind "$1"
}

if [ $# -eq 1 ] && is_doc "$1"; then
  [ -f "$1" ] || { echo "view: no such file: $1" >&2; exit 1; }
  if [ -n "${HC_TERMINAL_ID:-}" ]; then
    exec python3 "$mods/place.py" $tab "$1"
  fi
  exec open "$1"   # outside Herdr: the default app
fi

[ -n "$tab" ] && set -- --tab "$@"
exec /usr/bin/view "$@"
